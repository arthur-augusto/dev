{
  "layer": "top",
  "position": "top",
  "modules-left": ["hyprland/workspaces"],

  "modules-center": ["clock"],

  "modules-right": [
    "pulseaudio",
    "backlight",
    "battery",
    "cpu",
    "memory",
    "disk",
    "hyprland/language",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{name}: {icon}",
    "format-icons": {
      "active": "",
      "default": ""
    }
  },

  "clock": {
    "timezone": "America/Sao_Paulo",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%d/%m/%Y - %H:%M:%S}",
    "interval": 1
  },

  "pulseaudio": {
    "states": {
        "loud": 80
    },
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon}  {volume}%",
    "format-muted": "",
    "format-icons": {
      "headphones": "󰋋",
      "headset": "󰋎",
      "default": ["", "", " "]
    },
    "on-click": "pavucontrol"
  },

  "backlight": {
	"device": "intel_backlight",
	"format": "{icon} {percent}%",
	"format-icons": ["󰖨"]
  },

  "battery": {
      "states": {
          "warning": 30,
          "critical": 15
      },
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "format-plugged": "󰚥 {capacity}%",
      "format-alt": "{time} {icon}",
      "format-full": "󱟢 {capacity}%",
      "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "cpu": {
    "interval": 1,
    "format": "  {icon0}{icon1}{icon2}{icon3} {usage:>2}%",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
  },

  "memory": {
    "interval": 30,
    "format": "  {used:0.1f}GiB/{total:0.1f}GiB"
  },

  "disk": {
    "format": "{used}/{total}",
    "path": "/home",
    "tooltip": true,
    "format-alt": "{percentage_used}%"
  },

  "hyprland/language": {
      "format": "{short}"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  }
}
